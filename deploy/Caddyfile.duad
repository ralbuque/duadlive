# Bloco do Duad Live, importado pelo Caddyfile do veracibot
# (C:\Git\veracibot\deploy\windows\Caddyfile) com a linha:
#   import C:/Git/duadlive/deploy/Caddyfile.duad
#
# AJUSTE o caminho em "root" se o repositorio estiver em outra pasta no servidor.

duad.live {
	root * C:/Git/duadlive/prototype
	encode gzip

	# Na fase de testes, sempre servir a versao mais recente do arquivo
	header Cache-Control "no-cache"

	# A raiz do site abre o prototipo
	@root path /
	rewrite @root /duadlive-proto.html

	file_server
}

www.duad.live {
	redir https://duad.live{uri} permanent
}
